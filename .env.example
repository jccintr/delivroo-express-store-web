VITE_API_BASE_URL=http://localhost:3000/api

# Chave do Google Maps para uso NO NAVEGADOR (Maps JavaScript API + Places API),
# usada pelo autocomplete de endereço na tela de Nova Entrega.
#
# IMPORTANTE:
# - Esta chave é DIFERENTE da GOOGLE_MAPS_API_KEY usada no backend
#   (api-delivroo-express-node), que faz Geocoding e Distance Matrix.
# - Como ela fica exposta no bundle do navegador, restrinja-a no Google
#   Cloud Console por HTTP referrer (domínio de produção + localhost em
#   dev) e habilite só as APIs "Maps JavaScript API" e "Places API".
#   Nunca reutilize a chave de servidor aqui.
VITE_GOOGLE_MAPS_API_KEY=